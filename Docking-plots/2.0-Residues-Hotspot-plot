make_site_plot <- function(site_i) {
  df <- site_results[[site_i]]$summary %>%
    mutate(
      favorability = -affinity_for_size,
      compound = factor(as.character(compound), levels = site_results[[site_i]]$compounds),
      residue = factor(as.character(residue), levels = rev(site_results[[site_i]]$residues))
    )
  
  compounds_here <- site_results[[site_i]]$compounds
  
  site_affinity_values <- df$affinity_for_size
  site_affinity_values <- site_affinity_values[!is.na(site_affinity_values) & is.finite(site_affinity_values)]
  
  if (length(site_affinity_values) == 0) {
    stop(paste0("No valid affinity values are available for plotting in site: ", site_i))
  }
  
  site_best_affinity <- min(site_affinity_values, na.rm = TRUE)      # most negative
  site_least_affinity <- max(site_affinity_values, na.rm = TRUE)     # most positive
  site_median_affinity <- median(site_affinity_values, na.rm = TRUE)
  
  site_legend_affinities <- c(site_least_affinity, site_median_affinity, site_best_affinity)
  site_legend_labels <- sprintf("%.2f", site_legend_affinities)
  
  df <- df %>%
    mutate(
      bubble_diameter = map_affinity_to_diameter(
        affinity_values = affinity_for_size,
        reference_values = site_affinity_values
      )
    )
  
  site_legend_diameters <- map_affinity_to_diameter(
    affinity_values = site_legend_affinities,
    reference_values = site_affinity_values
  )
  
  ggplot(df, aes(x = compound, y = residue)) +
    geom_point(
      aes(size = bubble_diameter, fill = compound),
      shape = 21,
      colour = "black",
      stroke = 0.45,
      alpha = 0.92,
      na.rm = TRUE
    ) +
    scale_fill_manual(
      values = COMPOUND_COLORS[compounds_here],
      breaks = compounds_here,
      drop = FALSE,
      name = "Compounds"
    ) +
    scale_size_identity(
      breaks = site_legend_diameters,
      labels = site_legend_labels,
      name = affinity_legend_title,
      guide = "legend"
    ) +
    scale_x_discrete(drop = FALSE) +
    scale_y_discrete(drop = FALSE) +
    labs(
      title = SITE_TITLES[[site_i]],
      x = NULL,
      y = "Residue hotspot"
    ) +
    guides(
      fill = guide_legend(override.aes = list(size = 5), order = 1),
      size = guide_legend(order = 2)
    ) +
    theme_classic(base_size = 14) +
    theme(
      plot.title = element_text(size = 20, face = "bold", hjust = 0.5, margin = margin(b = 16)),
      axis.title.x = element_blank(),
      axis.title.y = element_text(size = 16, face = "plain", margin = margin(r = 15)),
      axis.text.x = element_text(
        family = "Arial",
        size = 13.5,
        face = "plain",
        angle = 0,
        hjust = 0.5,
        color = "black",
        margin = margin(t = 5)
      ),
      axis.text.y = element_text(size = 13, face = "plain", color = "black"),
      axis.ticks = element_blank(),
      panel.grid.major.y = element_line(linewidth = 0.35, colour = "grey88"),
      panel.grid.major.x = element_line(linewidth = 0.25, colour = "grey93"),
      panel.grid.minor = element_blank(),
      legend.position = "right",
      legend.title = element_text(size = 12.5, face = "plain"),
      legend.text = element_text(size = 11.5, face = "plain"),
      legend.box = "vertical",
      plot.margin = margin(20, 20, 20, 20)
    )
}

