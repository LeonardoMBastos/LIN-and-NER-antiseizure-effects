# 5) METADATA RESOLUTION -------------------------------------
compound_cache <- new.env(parent = emptyenv())
site_cache <- new.env(parent = emptyenv())

resolve_compound <- function(raw_value, default_value, context) {
  detected <- standardize_compound(raw_value)
  if (!is.null(detected)) return(detected)
  if (is_missing_value(raw_value) && !is.null(default_value)) return(default_value)
  
  if (!is_missing_value(raw_value) && normalize_text(raw_value) %in% c("ger", "geraniol", "gerac", "geranylacetate")) {
    stop("The input contains GER/GERAC labels. Use a LIN/NER dataset or correct the compound labels in the source file: ", context)
  }
  
  raw_string <- if (is_missing_value(raw_value)) "<missing>" else as.character(raw_value)
  key <- paste(context, raw_string, sep = "||")
  
  if (!exists(key, envir = compound_cache, inherits = FALSE)) {
    cat("\nCould not identify COMPOUND automatically.\n")
    cat("Source: ", context, "\n", sep = "")
    if (!is_missing_value(raw_value)) cat("Observed value: ", raw_value, "\n", sep = "")
    
    selected <- ask_choice("Which compound does this dataset represent?", COMPOUND_ORDER)
    assign(key, selected, envir = compound_cache)
  }
  
  get(key, envir = compound_cache, inherits = FALSE)
}

resolve_site <- function(raw_value, default_value, context) {
  detected <- standardize_site(raw_value)
  if (!is.null(detected)) return(detected)
  if (is_missing_value(raw_value) && !is.null(default_value)) return(default_value)
  
  raw_string <- if (is_missing_value(raw_value)) "<missing>" else as.character(raw_value)
  key <- paste(context, raw_string, sep = "||")
  
  if (!exists(key, envir = site_cache, inherits = FALSE)) {
    cat("\nCould not identify BINDING SITE automatically.\n")
    cat("Source: ", context, "\n", sep = "")
    if (!is_missing_value(raw_value)) cat("Observed value: ", raw_value, "\n", sep = "")
    
    selected <- ask_choice("Which binding site does this dataset represent?", SITE_ORDER)
    assign(key, selected, envir = site_cache)
  }
  
  get(key, envir = site_cache, inherits = FALSE)
}

