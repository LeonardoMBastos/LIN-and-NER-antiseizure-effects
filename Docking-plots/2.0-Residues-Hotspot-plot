interaction_records <- list()
pose_records <- list()
interaction_counter <- 1L
pose_counter <- 1L
valid_tables <- 0L

for (file in selected_files) {
  filename <- basename(file)
  tables <- read_source_tables(file)
  
  for (sheet_name in names(tables)) {
    df <- as.data.frame(tables[[sheet_name]], stringsAsFactors = FALSE)
    if (nrow(df) == 0) next
    
    names(df) <- trimws(names(df))
    
    basic <- identify_basic_columns(names(df))
    residue_columns <- identify_residue_columns(names(df))
    
    if (is.null(basic$pose_ID) || is.null(basic$affinity) || length(residue_columns) == 0) next
    
    valid_tables <- valid_tables + 1L
    metadata <- identify_metadata_columns(names(df))
    
    POSE_COLUMN <- basic$pose_ID
    AFFINITY_COLUMN <- basic$affinity
    COMPOUND_COLUMN <- metadata$compound
    SITE_COLUMN <- metadata$site
    
    context <- paste(filename, sheet_name, sep = " | ")
    default_compound <- infer_compound_from_context(context)
    default_site <- infer_site_from_context(context, default_compound)
    
    cat("\nReading: ", context, "\n", sep = "")
    cat("  Compound inferred: ", if (is.null(default_compound)) "not identified" else default_compound, "\n", sep = "")
    cat("  Site inferred: ", if (is.null(default_site)) "not identified" else default_site, "\n", sep = "")
    
    for (row_index in seq_len(nrow(df))) {
      pose_id <- trimws(as.character(df[[POSE_COLUMN]][row_index]))
      affinity <- to_numeric(df[[AFFINITY_COLUMN]][row_index])
      
      if (is.na(affinity) || is.na(pose_id) || pose_id == "") next
      
      row_context <- paste(context, pose_id, sep = " | ")
      row_default_compound <- infer_compound_from_context(pose_id)
      if (is.null(row_default_compound)) row_default_compound <- default_compound
      
      raw_compound <- if (!is.null(COMPOUND_COLUMN)) df[[COMPOUND_COLUMN]][row_index] else NA_character_
      compound <- resolve_compound(raw_compound, row_default_compound, context)
      
      row_default_site <- infer_site_from_context(row_context, compound)
      if (is.null(row_default_site)) row_default_site <- default_site
      
      raw_site <- if (!is.null(SITE_COLUMN)) df[[SITE_COLUMN]][row_index] else NA_character_
      site <- resolve_site(raw_site, row_default_site, context)
      source_ID <- paste(filename, sheet_name, sep = "::")
      
      pose_records[[pose_counter]] <- data.frame(
        source_ID = source_ID,
        site = site,
        compound = compound,
        pose_ID = pose_id,
        affinity = affinity,
        stringsAsFactors = FALSE
      )
      pose_counter <- pose_counter + 1L
      
      for (residue_pair in residue_columns) {
        residue_col <- residue_pair$residue
        contacts_col <- residue_pair$contacts
        
        residue <- df[[residue_col]][row_index]
        contacts <- to_numeric(df[[contacts_col]][row_index])
        
        if (is_missing_value(residue)) next
        if (is.na(contacts) || contacts <= 0) next
        
        interaction_records[[interaction_counter]] <- data.frame(
          source_ID = source_ID,
          site = site,
          compound = compound,
          pose_ID = pose_id,
          affinity = affinity,
          residue = trimws(as.character(residue)),
          contacts = contacts,
          stringsAsFactors = FALSE
        )
        interaction_counter <- interaction_counter + 1L
      }
    }
  }
}

