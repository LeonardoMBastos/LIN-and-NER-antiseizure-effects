# 3) HELPER FUNCTIONS -----------------------------------------
normalize_text <- function(x) {
  x <- as.character(x)
  x[is.na(x)] <- ""
  gsub("[^a-z0-9]", "", trimws(tolower(x)))
}

context_tokens <- function(x) {
  z <- unlist(strsplit(tolower(as.character(x)), "[^a-z0-9]+"))
  z[z != ""]
}

to_numeric <- function(x) {
  x <- trimws(as.character(x))
  x <- gsub(",", ".", x, fixed = TRUE)
  suppressWarnings(as.numeric(x))
}

is_missing_value <- function(x) {
  if (is.null(x) || length(x) == 0) return(TRUE)
  x <- x[1]
  if (is.na(x)) return(TRUE)
  trimws(as.character(x)) == ""
}

identify_basic_columns <- function(columns) {
  n <- normalize_text(columns)
  out <- list()
  
  for (alias in c("poseid", "pose")) {
    idx <- which(n == alias)
    if (length(idx) > 0) {
      out$pose_ID <- columns[idx[1]]
      break
    }
  }
  
  for (alias in c("affinity", "afinidade", "bindingaffinity", "dockingaffinity")) {
    idx <- which(n == alias)
    if (length(idx) > 0) {
      out$affinity <- columns[idx[1]]
      break
    }
  }
  
  out
}

identify_metadata_columns <- function(columns) {
  n <- normalize_text(columns)
  out <- list()
  
  for (alias in c("compound", "composto", "ligand", "ligante", "molecule", "molecula")) {
    idx <- which(n == alias)
    if (length(idx) > 0) {
      out$compound <- columns[idx[1]]
      break
    }
  }
  
  for (alias in c("site", "bindingsite", "bindingpocket", "pocket", "sitio", "sitiodeligacao")) {
    idx <- which(n == alias)
    if (length(idx) > 0) {
      out$site <- columns[idx[1]]
      break
    }
  }
  
  out
}

identify_residue_columns <- function(columns) {
  n <- normalize_text(columns)
  out <- list()
  k <- 1L
  
  for (i in seq_along(columns)) {
    m <- regexec("^residue([0-9]+)$", n[i])
    p <- regmatches(n[i], m)[[1]]
    if (length(p) != 2) next
    
    index <- p[2]
    contact_idx <- which(n == paste0("contacts", index))
    if (length(contact_idx) == 0) next
    
    out[[k]] <- list(
      index = as.integer(index),
      residue = columns[i],
      contacts = columns[contact_idx[1]]
    )
    k <- k + 1L
  }
  
  if (length(out) == 0) return(list())
  out[order(vapply(out, function(x) x$index, numeric(1)))]
}

standardize_compound <- function(value) {
  if (is_missing_value(value)) return(NULL)
  n <- normalize_text(value)
  
  if (n == "dzp" || grepl("diazepam", n)) return("DZP")
  if (n == "phb" || grepl("phenobarbital|phenobarbitone", n)) return("PHB")
  if (n == "gaba" || grepl("gammaaminobutyricacid", n)) return("GABA")
  if (n == "lin" || grepl("linalool|linalol", n)) return("LIN")
  if (n == "ner" || grepl("nerolidol", n)) return("NER")
  
  NULL
}

standardize_site <- function(value) {
  if (is_missing_value(value)) return(NULL)
  n <- normalize_text(value)
  
  if (n == "bzd" || grepl("benzodiazep", n)) return("BZD")
  if (n == "bb" || grepl("barbiturat", n)) return("Barbiturates")
  if (n == "gaba" || grepl("orthoster|gabasite|sitegaba", n)) return("GABA")
  
  NULL
}

infer_compound_from_context <- function(text) {
  tokens <- context_tokens(text)
  compact <- normalize_text(text)
  matches <- character(0)
  
  if ("dzp" %in% tokens || "diazepam" %in% tokens) matches <- c(matches, "DZP")
  if ("phb" %in% tokens || "phenobarbital" %in% tokens || "phenobarbitone" %in% tokens) matches <- c(matches, "PHB")
  if ("lin" %in% tokens || "linalool" %in% tokens || "linalol" %in% tokens || grepl("linalool|linalol", compact)) matches <- c(matches, "LIN")
  if ("ner" %in% tokens || "nerolidol" %in% tokens || grepl("nerolidol", compact)) matches <- c(matches, "NER")
  
  if ("gaba" %in% tokens && !any(tokens %in% c("site", "orthosteric", "orthosterico"))) {
    matches <- c(matches, "GABA")
  }
  
  matches <- unique(matches)
  if (length(matches) == 1L) return(matches)
  NULL
}

infer_site_from_context <- function(text, inferred_compound = NULL) {
  tokens <- context_tokens(text)
  compact <- normalize_text(text)
  
  if ("bzd" %in% tokens || grepl("benzodiazep", compact)) return("BZD")
  if ("bb" %in% tokens || grepl("barbiturat", compact)) return("Barbiturates")
  if (any(tokens %in% c("orthosteric", "orthosterico")) || grepl("gabasite|sitegaba", compact)) return("GABA")
  
  gaba_count <- sum(tokens == "gaba")
  if (gaba_count >= 2) return("GABA")
  if (gaba_count >= 1 && !identical(inferred_compound, "GABA")) return("GABA")
  
  NULL
}

ask_choice <- function(question, options) {
  cat("\n", question, "\n", sep = "")
  for (i in seq_along(options)) cat(sprintf("  %d. %s\n", i, options[i]))
  
  repeat {
    ans <- suppressWarnings(as.integer(readline("Enter the number: ")))
    if (!is.na(ans) && ans >= 1 && ans <= length(options)) return(options[ans])
    message("Invalid option. Please try again.")
  }
}

count_fixed <- function(lines, pattern) {
  sum(vapply(lines, function(x) {
    hits <- gregexpr(pattern, x, fixed = TRUE)[[1]]
    if (length(hits) == 1 && hits[1] == -1) 0L else length(hits)
  }, integer(1)))
}

detect_delimiter <- function(file) {
  lines <- readLines(file, n = 5, warn = FALSE)
  counts <- c(
    comma = count_fixed(lines, ","),
    semicolon = count_fixed(lines, ";"),
    tab = count_fixed(lines, "\t")
  )
  
  switch(
    names(counts)[which.max(counts)],
    comma = ",",
    semicolon = ";",
    tab = "\t",
    ","
  )
}

read_source_tables <- function(file) {
  ext <- tolower(tools::file_ext(file))
  
  if (ext == "csv") {
    dat <- readr::read_delim(
      file,
      delim = detect_delimiter(file),
      show_col_types = FALSE,
      progress = FALSE,
      trim_ws = TRUE,
      name_repair = "minimal"
    )
    return(list(CSV = dat))
  }
  
  if (ext %in% c("xlsx", "xls")) {
    sheets <- readxl::excel_sheets(file)
    out <- vector("list", length(sheets))
    names(out) <- sheets
    
    for (i in seq_along(sheets)) {
      out[[i]] <- readxl::read_excel(
        file,
        sheet = sheets[i],
        .name_repair = "minimal"
      )
    }
    return(out)
  }
  
  stop("Unsupported file type: ", ext)
}

map_affinity_to_diameter <- function(affinity_values, reference_values, min_diameter = BUBBLE_MIN_DIAMETER, max_diameter = BUBBLE_MAX_DIAMETER, positive_max_ratio = POSITIVE_MAX_DIAMETER_RATIO) {
  positive_cap <- max_diameter * positive_max_ratio
  out <- rep(NA_real_, length(affinity_values))
  
  reference_values <- reference_values[is.finite(reference_values)]
  if (length(reference_values) == 0) return(out)
  
  non_positive_reference <- reference_values[reference_values <= 0]
  positive_reference <- reference_values[reference_values > 0]
  
  has_non_positive <- length(non_positive_reference) > 0
  has_positive <- length(positive_reference) > 0
  
  best_negative <- if (has_non_positive) min(non_positive_reference, na.rm = TRUE) else NA_real_
  worst_positive <- if (has_positive) max(positive_reference, na.rm = TRUE) else NA_real_
  
  for (i in seq_along(affinity_values)) {
    value <- affinity_values[i]
    if (!is.finite(value)) next
    
    if (value > 0) {
      if (!has_positive || !is.finite(worst_positive) || worst_positive <= 0) {
        out[i] <- positive_cap
      } else if (isTRUE(all.equal(worst_positive, 0))) {
        out[i] <- positive_cap
      } else {
        proportion <- value / worst_positive
        proportion <- max(0, min(1, proportion))
        out[i] <- positive_cap - proportion * (positive_cap - min_diameter)
      }
    } else {
      if (!has_non_positive || !is.finite(best_negative)) {
        out[i] <- positive_cap
      } else if (isTRUE(all.equal(best_negative, 0))) {
        out[i] <- positive_cap
      } else {
        proportion <- value / best_negative
        proportion <- max(0, min(1, proportion))
        out[i] <- positive_cap + proportion * (max_diameter - positive_cap)
      }
    }
  }
  
  out
}

