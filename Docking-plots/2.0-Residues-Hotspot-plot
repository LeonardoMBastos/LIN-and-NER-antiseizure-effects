# 10) CALCULATE TOP 10 FOR EACH SITE -------------------------
site_results <- list()
all_affinities_for_legend <- numeric(0)

for (site_i in sites) {
  site_df <- pose_residue_df %>% filter(site == site_i)
  
  compounds_here <- COMPOUND_ORDER[
    COMPOUND_ORDER %in% unique(site_df$compound)
  ]
  
  hotspot_ranking <- site_df %>%
    group_by(residue) %>%
    summarise(
      interacting_poses = n_distinct(pose_key),
      total_contacts = sum(contacts, na.rm = TRUE),
      compounds_present = n_distinct(compound),
      .groups = "drop"
    ) %>%
    arrange(desc(interacting_poses), desc(total_contacts), residue) %>%
    mutate(hotspot_rank = row_number())
  
  top_hotspots <- hotspot_ranking %>% slice_head(n = TOP_N_HOTSPOTS)
  hotspot_residues <- top_hotspots$residue
  
  summary_df <- site_df %>%
    filter(residue %in% hotspot_residues) %>%
    group_by(compound, residue) %>%
    summarise(
      n_interacting_poses = n_distinct(pose_key),
      mean_affinity = mean(affinity, na.rm = TRUE),
      median_affinity = median(affinity, na.rm = TRUE),
      best_affinity = min(affinity, na.rm = TRUE),
      worst_affinity = max(affinity, na.rm = TRUE),
      total_contacts = sum(contacts, na.rm = TRUE),
      .groups = "drop"
    )
  
  full_grid <- expand_grid(
    compound = compounds_here,
    residue = hotspot_residues
  )
  
  summary_df <- full_grid %>%
    left_join(summary_df, by = c("compound", "residue")) %>%
    left_join(top_hotspots %>% select(residue, hotspot_rank), by = "residue")
  
  total_pose_df <- poses_df %>%
    filter(site == site_i) %>%
    group_by(compound) %>%
    summarise(total_compound_poses = n_distinct(pose_key), .groups = "drop")
  
  summary_df <- summary_df %>%
    left_join(total_pose_df, by = "compound") %>%
    mutate(
      n_interacting_poses = replace_na(n_interacting_poses, 0L),
      total_contacts = replace_na(total_contacts, 0),
      interaction_frequency_percent = 100 * n_interacting_poses / total_compound_poses
    )
  
  if (tolower(AFFINITY_FOR_SIZE) == "mean") {
    summary_df <- summary_df %>% mutate(affinity_for_size = mean_affinity)
    affinity_legend_title <- "Mean affinity\n(kcal/mol)"
  } else if (tolower(AFFINITY_FOR_SIZE) == "best") {
    summary_df <- summary_df %>% mutate(affinity_for_size = best_affinity)
    affinity_legend_title <- "Best affinity\n(kcal/mol)"
  } else {
    stop('AFFINITY_FOR_SIZE must be "mean" or "best".')
  }
  
  summary_df <- summary_df %>%
    mutate(
      site = site_i,
      compound = factor(compound, levels = compounds_here),
      residue = factor(residue, levels = rev(hotspot_residues))
    ) %>%
    arrange(hotspot_rank, compound)
  
  all_affinities_for_legend <- c(all_affinities_for_legend, summary_df$affinity_for_size)
  
  site_results[[site_i]] <- list(
    summary = summary_df,
    ranking = hotspot_ranking,
    top_hotspots = top_hotspots,
    residues = hotspot_residues,
    compounds = compounds_here
  )
}

