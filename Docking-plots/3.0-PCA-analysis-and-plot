make_correlation_matrix <- function(X, method = "pearson") {
  cor(
    X,
    method = method,
    use = "pairwise.complete.obs"
  )
}

pearson_BZD <- make_correlation_matrix(
  pca_BZD$fingerprint,
  method = "pearson"
)

pearson_BB <- make_correlation_matrix(
  pca_BB$fingerprint,
