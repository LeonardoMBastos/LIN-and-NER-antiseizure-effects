save_site_figure <- function(plot_obj, site_tag, width = PCA_FIGURE_WIDTH, height = PCA_FIGURE_HEIGHT) {
  png_file <- file.path(
    output_dir,
    paste0("PCA_", site_tag, ".png")
  )

  tiff_file <- file.path(
    output_dir,
    paste0("PCA_", site_tag, ".tiff")
  )

  ggsave(
    filename = png_file,
    plot = plot_obj,
    width = width,
    height = height,
    units = "in",
    dpi = 400,
    bg = "white"
  )

  ggsave(
    filename = tiff_file,
    plot = plot_obj,
    width = width,
    height = height,
    units = "in",
    dpi = 600,
    compression = "lzw",
    bg = "white"
  )
}

