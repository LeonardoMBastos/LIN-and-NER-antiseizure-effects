# ==============================================================================
# 11. MINI PCA INSET
# ==============================================================================

make_residue_inset <- function(loadings_df) {
  inset_df <- loadings_df %>%
    mutate(label = residue)

  max_x <- max(abs(inset_df$PC1), na.rm = TRUE)
  max_y <- max(abs(inset_df$PC2), na.rm = TRUE)

  lim_x <- max_x * 1.40
  lim_y <- max_y * 1.40

  if (!is.finite(lim_x) || lim_x == 0) lim_x <- 1
  if (!is.finite(lim_y) || lim_y == 0) lim_y <- 1

  ggplot(inset_df, aes(x = PC1, y = PC2)) +
    geom_hline(
      yintercept = 0,
      colour = "grey45",
      linewidth = 0.28
    ) +
    geom_vline(
      xintercept = 0,
      colour = "grey45",
      linewidth = 0.28
    ) +
    geom_segment(
      aes(x = 0, y = 0, xend = PC1, yend = PC2),
      arrow = grid::arrow(
        length = grid::unit(0.10, "cm"),
        type = "open"
      ),
      linewidth = 0.28,
      colour = "black"
    ) +
    geom_point(
      size = 0.55,
      colour = "black"
    ) +
    ggrepel::geom_label_repel(
      aes(label = label),
      seed = 1234,
      size = 2.15,
      colour = "black",
      fontface = "italic",
      fill = grDevices::adjustcolor("white", alpha.f = 0.92),
      label.size = 0,
      label.padding = grid::unit(0.08, "lines"),
      box.padding = 0.55,
      point.padding = 0.18,
      segment.colour = "grey55",
      segment.linewidth = 0.18,
      force = 9,
      force_pull = 0.10,
      max.overlaps = Inf,
      min.segment.length = 0,
      max.time = 8,
      direction = "both"
    ) +
    annotate(
      "text",
      x = lim_x * 0.94,
      y = -lim_y * 0.055,
      label = "PC1",
      size = 2.25,
      hjust = 1,
      vjust = 1
    ) +
    annotate(
      "text",
      x = lim_x * 0.035,
      y = lim_y * 0.94,
      label = "PC2",
      size = 2.25,
      angle = 90,
      hjust = 1,
      vjust = 1
    ) +
    coord_cartesian(
      xlim = c(-lim_x, lim_x),
      ylim = c(-lim_y, lim_y),
      clip = "on",
      expand = FALSE
    ) +
    theme_classic(base_size = 8) +
    theme(
      axis.title = element_blank(),
      axis.text = element_blank(),
      axis.ticks = element_blank(),
      panel.border = element_blank(),
      plot.background = element_rect(fill = NA, colour = NA),
      panel.background = element_rect(
        fill = grDevices::adjustcolor("white", alpha.f = 0.60),
        colour = NA
      ),
      plot.margin = margin(0, 0, 0, 0)
    )
}


# ==============================================================================
# 12. GRAPH LAYOUT SETTINGS
# ==============================================================================
# IMPORTANT: The PCA axes use the EXACT automatic-scales logic of the
# original grouped PCA script. Do not derive xlim/ylim from the scores.
# ggplot2 must also account for the 95% confidence ellipses.
#
# The inset occupies the RIGHT side, outside the PCA panel. Its bottom
# horizontal X axis is aligned with the main PCA bottom X axis.
# ==============================================================================

PCA_FIGURE_WIDTH <- 8.2       # inches
PCA_FIGURE_HEIGHT <- 7.1      # inches
PCA_MAIN_WIDTH_FRAC <- 0.725  # left fraction for original PCA plot
INSET_WIDTH_FRAC <- 0.240    # right inset width on full canvas
INSET_HEIGHT_FRAC <- 0.395   # about half of main PCA panel height
INSET_GAP_FRAC <- 0.014
INSET_BOTTOM_FRAC <- 0.135 # adjust only the inset up/down if needed
LEGEND_HEIGHT_FRAC <- 0.095


# ==============================================================================
# 13. MAIN PCA FUNCTION — ORIGINAL PCA AXES + SMALL EXTERNAL INSET
# ==============================================================================

plot_pca_with_right_inset <- function(pca_result, title, n_residues = 8) {
  scores <- pca_result$scores
  centroids <- pca_result$centroids
  variance <- pca_result$variance

  loadings_top <- pca_result$loadings_PC12 %>%
    slice_head(n = n_residues)

  ellipse_scores <- scores %>%
    group_by(compound) %>%
    filter(n() >= 3) %>%
    ungroup()

  compounds_present <- scores %>%
    pull(compound) %>%
    as.character() %>%
    unique()

  compounds_present <- compound_levels[
    compound_levels %in% compounds_present
  ]

  # --------------------------------------------------------------------------
  # MAIN PCA — SAME GEOMETRIES AND SAME AXIS SETTINGS AS THE GROUPED FIGURE
  # --------------------------------------------------------------------------
  main_plot <- ggplot(scores, aes(x = PC1, y = PC2)) +
    geom_hline(
      yintercept = 0,
      colour = "grey82",
      linewidth = 0.45
    ) +
    geom_vline(
      xintercept = 0,
      colour = "grey82",
      linewidth = 0.45
    ) +
    stat_ellipse(
      data = ellipse_scores,
      aes(fill = compound, group = compound),
      geom = "polygon",
      type = "norm",
      level = 0.95,
      alpha = 0.10,
      colour = NA,
      show.legend = FALSE
    ) +
    stat_ellipse(
      data = ellipse_scores,
      aes(colour = compound, group = compound),
      type = "norm",
      level = 0.95,
      linewidth = 0.55,
      alpha = 0.95,
      show.legend = FALSE
    ) +
    geom_point(
      aes(colour = compound),
      size = 2.1,
      alpha = 0.72,
      show.legend = TRUE
    ) +
    geom_point(
      data = centroids,
      aes(x = PC1, y = PC2, fill = compound),
      inherit.aes = FALSE,
      shape = 23,
      size = 4.2,
      colour = "black",
      stroke = 0.85,
      show.legend = FALSE
    ) +
    scale_colour_manual(
      values = compound_colors,
      limits = compounds_present,
      breaks = compounds_present,
      drop = FALSE,
      name = "Compound"
    ) +
    scale_fill_manual(
      values = compound_colors,
      limits = compounds_present,
      breaks = compounds_present,
      drop = FALSE,
      guide = "none"
    ) +
    # EXACT original PCA axis expansion; includes ellipse extents.
    scale_x_continuous(
      expand = expansion(mult = c(0.08, 0.08))
    ) +
    scale_y_continuous(
      expand = expansion(mult = c(0.08, 0.08))
    ) +
    coord_cartesian(clip = "on") +
    labs(
      title = title,
      x = paste0(
        "PC1 (",
        round(variance$variance_percent[variance$PC == "PC1"], 1),
        "%)"
      ),
      y = paste0(
        "PC2 (",
        round(variance$variance_percent[variance$PC == "PC2"], 1),
        "%)"
      )
    ) +
    theme_classic(base_size = 13) +
    theme(
      plot.title = element_text(face = "bold", hjust = 0.5, size = 14),
      axis.title = element_text(face = "plain"),
      axis.text = element_text(face = "plain"),
      legend.position = "bottom",
      legend.direction = "horizontal",
      legend.box = "horizontal",
      legend.justification = "center",
      legend.title = element_text(face = "plain", size = 11.5),
      legend.text = element_text(face = "plain", size = 10.5),
      legend.spacing.x = grid::unit(0.10, "cm"),
      plot.margin = margin(8, 8, 8, 8)
    ) +
    guides(
      colour = guide_legend(
        nrow = 1,
        byrow = TRUE,
        title.position = "left",
        override.aes = list(size = 3.1, alpha = 1)
      )
    )

  # Extract this particular site's legend and put it BELOW the whole figure.
  site_legend <- cowplot::get_legend(main_plot)
  main_plot_no_legend <- main_plot + theme(legend.position = "none")
  inset_plot <- make_residue_inset(loadings_top)

  # Align the inset's bottom horizontal X axis with the PCA X axis.
  # Neither the original PCA X axis nor its Y axis is recalculated.
  # The single parameter below controls only the inset position.
  inset_bottom <- INSET_BOTTOM_FRAC
  inset_left <- PCA_MAIN_WIDTH_FRAC + INSET_GAP_FRAC

  # The PCA itself is unchanged: only its physical placement on the canvas
  # and the completely separate inset panel are modified.
  upper_figure <- cowplot::ggdraw() +
    cowplot::draw_plot(
      main_plot_no_legend,
      x = 0,
      y = 0,
      width = PCA_MAIN_WIDTH_FRAC,
      height = 1
    ) +
    cowplot::draw_plot(
      inset_plot,
      x = inset_left,
      y = inset_bottom,
      width = INSET_WIDTH_FRAC,
      height = INSET_HEIGHT_FRAC
    )

  final_figure <- cowplot::plot_grid(
    upper_figure,
    site_legend,
    ncol = 1,
    rel_heights = c(1 - LEGEND_HEIGHT_FRAC, LEGEND_HEIGHT_FRAC)
  )

  return(final_figure)
}


