) %>%
  mutate(site = factor(site, levels = site_levels)) %>%
  arrange(site, desc(pearson_abs))

chord_nodes_all <- bind_rows(
  pca_BZD$chord_nodes,
  pca_BB$chord_nodes,
  pca_GABA$chord_nodes
) %>%
  mutate(site = factor(site, levels = site_levels)) %>%
  arrange(site, desc(PC1_PC2_magnitude))

chord_variance <- variance_all %>%
  filter(PC %in% c("PC1", "PC2")) %>%
  select(site, PC, eigenvalue, variance_percent, cumulative_percent)


# ==============================================================================
# 17. ADD PCA INFORMATION FOR BOTH RESIDUES TO EACH CHORD EDGE
# ==============================================================================

nodes_residue_1 <- chord_nodes_all %>%
  transmute(
    site,
    residue_1 = residue,
    residue_1_PC1_loading = PC1_loading,
    residue_1_PC1_abs_loading = PC1_abs_loading,
    residue_1_PC1_direction = PC1_direction,
    residue_1_PC1_contribution_percent = PC1_contribution_percent,
    residue_1_PC2_loading = PC2_loading,
    residue_1_PC2_abs_loading = PC2_abs_loading,
    residue_1_PC2_direction = PC2_direction,
    residue_1_PC2_contribution_percent = PC2_contribution_percent,
    residue_1_PC1_PC2_magnitude = PC1_PC2_magnitude
  )

nodes_residue_2 <- chord_nodes_all %>%
  transmute(
    site,
    residue_2 = residue,
    residue_2_PC1_loading = PC1_loading,
    residue_2_PC1_abs_loading = PC1_abs_loading,
