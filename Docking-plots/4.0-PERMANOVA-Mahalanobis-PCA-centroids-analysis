wb <- openxlsx::createWorkbook()
add_table_sheet <- function(wb, tab_name, dat) {
  openxlsx::addWorksheet(wb, tab_name)
  if (is.null(dat) || !is.data.frame(dat) || !ncol(dat) || !nrow(dat)) {
    openxlsx::writeData(wb, tab_name, "No results available")
    return(invisible(NULL))
  }
  openxlsx::writeData(wb, tab_name, dat)
  header <- openxlsx::createStyle(textDecoration = "bold", border = "Bottom")
  openxlsx::addStyle(wb, tab_name, style = header, rows = 1L,
                     cols = seq_len(ncol(dat)), gridExpand = TRUE)
  openxlsx::freezePane(wb, tab_name, firstRow = TRUE)
  openxlsx::setColWidths(wb, tab_name, cols = seq_len(ncol(dat)), widths = "auto")
}

