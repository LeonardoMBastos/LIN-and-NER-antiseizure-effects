
# ============================================================
# GABAA alpha1-beta2-gamma2
# VISUALIZACAO PADRONIZADA E REPRODUTIVEL
# ============================================================
#
# MODELO:
#   #1 = Receptor completo
#
# CADEIAS:
#   beta2  = A e C
#   alpha1 = B e D
#   gamma2 = E
#
# IMPORTANTE:
#   Apenas o modelo #1 sera modificado.
#   Modelos #2, #3 e demais permanecem preservados.
#
# ============================================================


# ============================================================
# 1. AJUSTES GERAIS
# ============================================================

set bgColor white

lighting soft

graphics silhouettes true
graphics silhouettes width 1.2
graphics silhouettes color gray70


# ============================================================
# 2. LIMPAR REPRESENTACOES ANTERIORES
# EXCLUSIVAMENTE DO RECEPTOR #1
# ============================================================

hide #1 atoms
hide #1 bonds
hide #1 cartoons
hide #1 ribbons

surface close #1


# ============================================================
# 3. PALETA PADRONIZADA DE CORES
# ============================================================

# beta2 (A,C) - roxo pastel intermediario
colordef beta2_pastel #B8A8D9

# alpha1 (B,D) - lilas pastel claro
colordef alpha1_pastel #D8CBEF

# gamma2 (E) - roxo pastel mais escuro
colordef gamma2_pastel #8F7CB8


# ============================================================
# 4. RECEPTOR COMPLETO (#1)
# SUPERFICIE MOLECULAR
# ============================================================

# Criar superficie molecular
surface #1

# Superficie solida
surface style #1 solid

# Transparencia padronizada
transparency #1 8 target s


# ============================================================
# 5. COLORACAO POR SUBUNIDADE
# SUPERFICIE MOLECULAR
# ============================================================

# beta2 - cadeias A e C
color #1/A beta2_pastel surfaces
color #1/C beta2_pastel surfaces

# alpha1 - cadeias B e D
color #1/B alpha1_pastel surfaces
color #1/D alpha1_pastel surfaces

# gamma2 - cadeia E
color #1/E gamma2_pastel surfaces


# ============================================================
# 6. CARTOON - ESTRUTURA SECUNDARIA
# ============================================================

# Mostrar cartoon do receptor
show #1 cartoons

# Cartoon translucido
transparency #1 65 target c

# beta2 - cadeias A e C
color #1/A beta2_pastel cartoons
color #1/C beta2_pastel cartoons

# alpha1 - cadeias B e D
color #1/B alpha1_pastel cartoons
color #1/D alpha1_pastel cartoons

# gamma2 - cadeia E
color #1/E gamma2_pastel cartoons


# ============================================================
# 7. REFINAMENTO DO CARTOON
# ============================================================

cartoon style #1 width 1.6 thick 0.35


# ============================================================
# 8. ENQUADRAMENTO
# ============================================================

view all

zoom 1.15

turn y 12
turn x -6


# ============================================================
# 9. EXPORTACAO OPCIONAL
# ============================================================

# Descomente para salvar a figura:
#
# save gabaa_standard_view.png width 2400 height 2400 supersample 3


# ============================================================
# FIM
# ============================================================
