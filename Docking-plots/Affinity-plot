# ============================================================
# 16. HALF-CLOUD FUNCTION
#
# IMPORTANT:
# The cloud polygon is built ONLY from the natural KDE support.
# It is never extended to the Y-axis limits. This prevents long
# degenerate polygon edges that can become triangular artifacts
# when the rightmost cloud is clipped by the plotting panel.
# ============================================================

calculate_half_cloud <- function(
    values,
    x_center,
    compound_name
) {
  values <- values[is.finite(values)]
  
  if (length(values) < 2) {
    return(NULL)
  }
  
  if (length(unique(round(values, 8))) == 1) {
    values <- c(
      values,
      values[1] + 0.000001
    )
  }
  
  density_result <- density(
    x = values,
    n = 2048,
    adjust = DENSITY_ADJUST,
    cut = 3,
    na.rm = TRUE
  )
  
  density_values <- density_result$y
  
  if (
    length(density_values) == 0 ||
    !all(is.finite(density_values)) ||
    max(density_values) <= 0
  ) {
    return(NULL)
  }
  
  threshold <- max(density_values) * DENSITY_TAIL_FRACTION
  
  valid_index <- which(density_values >= threshold)
  
  if (length(valid_index) < 5) {
    valid_index <- seq_along(density_values)
  }
  
  first_index <- min(valid_index)
  last_index  <- max(valid_index)
  
  y_density <- density_result$x[first_index:last_index]
  d_density <- density_values[first_index:last_index]
  
  d_scaled <- d_density / max(d_density)
  
  if (length(y_density) >= 2) {
    y_step <- median(diff(y_density))
    
    if (!is.finite(y_step) || y_step <= 0) {
      y_step <- max(diff(range(values)) / 1000, 0.000001)
    }
  } else {
    y_step <- 0.000001
  }
  
  taper_n <- CLOUD_TAPER_POINTS
  
  left_y <- seq(
    y_density[1] - taper_n * y_step,
    y_density[1] - y_step,
    length.out = taper_n
  )
  left_d <- seq(
    0,
    d_scaled[1],
    length.out = taper_n + 1
  )[-(taper_n + 1)]
  
  right_y <- seq(
    y_density[length(y_density)] + y_step,
    y_density[length(y_density)] + taper_n * y_step,
    length.out = taper_n
  )
  right_d <- seq(
    d_scaled[length(d_scaled)],
    0,
    length.out = taper_n + 1
  )[-1]
  
  y_density <- c(
    left_y,
    y_density,
    right_y
  )
  
  d_scaled <- c(
    left_d,
    d_scaled,
    right_d
  )
  
  # Do not append the plot limits to the cloud geometry.
  # The taper above already returns the KDE smoothly to zero at
  # its natural ends. Fixed Y-axis limits are applied only at the
  # coordinate stage later in the plot.
  
  baseline <- x_center + CLOUD_BASE_OFFSET
  x_outer  <- baseline + d_scaled * CLOUD_WIDTH
  
  data.frame(
    x = c(
      x_outer,
      rev(rep(baseline, length(y_density)))
    ),
    y = c(
      y_density,
      rev(y_density)
    ),
    compound_std = compound_name
  )
}


# ============================================================
# 17. CREATE ONE GRAPH PER SITE
# ============================================================

create_site_plot <- function(site_name) {
  
  site_data <- df_plot %>%
    filter(site_std == site_name)
  
  if (nrow(site_data) == 0) {
    cat(
      "\nNo data found for:",
      site_name,
      "\n"
    )
    return(NULL)
  }
  
  compounds_present <-
    compound_order[
      compound_order %in% unique(site_data$compound_std)
    ]
  
  if (length(compounds_present) == 0) {
    return(NULL)
  }
  
  number_compounds <- length(compounds_present)
  
  x_positions <- setNames(
    1 + (seq_len(number_compounds) - 1) * COMPOUND_SPACING,
    compounds_present
  )
  
  site_data <- site_data %>%
    filter(compound_std %in% compounds_present) %>%
    mutate(
      compound_std = factor(
        compound_std,
        levels = compounds_present
      ),
      x_center = unname(
        x_positions[as.character(compound_std)]
      ),
      x_observation_center =
        x_center - OBS_CENTER_OFFSET
    )
  
  
  # ----------------------------------------------------------
  # FIXED Y AXIS FOR EACH SITE
  # ----------------------------------------------------------
  
  y_cfg <- site_y_config[[site_name]]
  
  y_lower  <- y_cfg$lower
  y_upper  <- y_cfg$upper
  y_breaks <- y_cfg$breaks
  
  
  # ----------------------------------------------------------
  # INDIVIDUAL OBSERVATIONS
  # ----------------------------------------------------------
  
  dot_data <- site_data %>%
    group_by(compound_std) %>%
    mutate(
      x_dot =
        x_observation_center +
        runif(
          n(),
          min = -OBS_BAND_WIDTH / 2,
          max =  OBS_BAND_WIDTH / 2
        )
    ) %>%
    ungroup()
  
  
  # ----------------------------------------------------------
  # CLOUDS
  # ----------------------------------------------------------
  
  cloud_list <- list()
  
  for (current_compound in compounds_present) {
    
    current_data <- site_data %>%
      filter(
        as.character(compound_std) == current_compound
      )
    
    current_x <- unname(
      x_positions[[current_compound]]
    )
    
    current_cloud <- calculate_half_cloud(
      values = current_data$affinity,
      x_center = current_x,
      compound_name = current_compound
    )
    
    if (!is.null(current_cloud)) {
      cloud_list[[length(cloud_list) + 1]] <-
        current_cloud
    }
  }
  
  if (length(cloud_list) > 0) {
    cloud_data <- bind_rows(cloud_list) %>%
      mutate(
        compound_std = factor(
          compound_std,
          levels = compounds_present
        )
      )
  } else {
    cloud_data <- data.frame(
      x = numeric(0),
      y = numeric(0),
      compound_std = factor(
        character(0),
        levels = compounds_present
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # X AXIS
  # ----------------------------------------------------------
  
  x_breaks <- unname(x_positions)
  x_labels <- compounds_present
  
  # Use asymmetric panel padding. The right padding must be
  # larger than CLOUD_BASE_OFFSET + CLOUD_WIDTH so the rightmost
  # cloud (NER in these panels) is never clipped horizontally.
  x_left_padding <- max(
    0.40,
    OBS_CENTER_OFFSET + OBS_BAND_WIDTH / 2 + 0.08
  )
  
  x_right_padding <-
    CLOUD_BASE_OFFSET +
    CLOUD_WIDTH +
    0.08
  
  x_min_plot <- min(x_breaks) - x_left_padding
  x_max_plot <- max(x_breaks) + x_right_padding
  
  
  # ----------------------------------------------------------
  # BUILD GRAPH
  # ----------------------------------------------------------
  
  p <- ggplot()
  
  if (y_lower <= 0 && y_upper >= 0) {
    p <- p +
      geom_hline(
        yintercept = 0,
        color = "black",
        linewidth = 0.40,
        alpha = 0.55
      )
  }
  
  p <- p +
    geom_polygon(
      data = cloud_data,
      aes(
        x = x,
        y = y,
        group = compound_std,
        fill = compound_std
      ),
      alpha = CLOUD_ALPHA,
      color = NA,
      linewidth = 0,
      show.legend = FALSE
    ) +
    
    geom_point(
      data = dot_data,
      aes(
        x = x_dot,
        y = affinity,
        color = compound_std
      ),
      size = DOT_SIZE,
      alpha = DOT_ALPHA,
      show.legend = FALSE
    ) +
    
    geom_boxplot(
      data = site_data,
      aes(
        x = x_observation_center,
        y = affinity,
        group = compound_std,
        fill = compound_std
      ),
      width = OBS_BAND_WIDTH,
      alpha = BOX_ALPHA,
      color = "black",
      linewidth = BOX_LINEWIDTH,
      outlier.shape = NA,
      show.legend = FALSE
    ) +
    
    scale_fill_manual(
      values = colors,
      breaks = compounds_present,
      drop = TRUE
    ) +
    
    scale_color_manual(
      values = colors,
      breaks = compounds_present,
      drop = TRUE
    ) +
    
    scale_x_continuous(
      breaks = x_breaks,
      labels = x_labels,
      limits = c(
        x_min_plot,
        x_max_plot
      ),
      expand = c(0, 0)
    ) +
    
    scale_y_reverse(
      breaks = y_breaks,
      labels = y_breaks,
      expand = c(0, 0)
    ) +
    
    coord_cartesian(
      ylim = c(y_lower, y_upper),
      clip = "on"
    ) +
    
    labs(
      x = NULL,
      y = "Binding affinity (kcal/mol)",
      title = site_titles[[site_name]]
    ) +
    
    theme_minimal(
      base_size = 12,
      base_family = FONT_FAMILY
    ) +
    
    theme(
      panel.background = element_rect(
        fill = "transparent",
        color = NA
      ),
      
      plot.background = element_rect(
        fill = "transparent",
        color = NA
      ),
      
      panel.grid.minor = element_blank(),
      panel.grid.major.x = element_blank(),
      
      panel.grid.major.y = element_line(
        color = "grey82",
        linewidth = 0.38
      ),
      
      axis.line.x = element_line(
        color = "black",
        linewidth = 0.65
      ),
      
      axis.line.y = element_line(
        color = "black",
        linewidth = 0.65
      ),
      
      axis.ticks = element_line(
        color = "black",
        linewidth = 0.50
      ),
      
      axis.ticks.length = grid::unit(
        0.12,
        "cm"
      ),
      
      axis.text.x = element_text(
        size = 13.5,
        face = "plain",
        color = "black",
        margin = margin(t = 5)
      ),
      
      axis.text.y = element_text(
        size = 13,
        face = "plain",
        color = "black",
        margin = margin(r = 4)
      ),
      
      axis.title.y = element_text(
        size = 15,
        face = "plain",
        color = "black",
        margin = margin(r = 9)
      ),
      
      plot.title.position = "plot",
      
      plot.title = element_text(
        size = 16.5,
        face = "plain",
        hjust = 0,
        color = "black",
        margin = margin(b = 8)
      ),
      
      legend.position = "none",
      
      plot.margin = margin(
        t = 4,
        r = 5,
        b = 4,
        l = 4
      )
    )
  
  
  # ----------------------------------------------------------
  # SAVE
  # ----------------------------------------------------------
  
  output_file <- file.path(
    output_dir,
    site_file_names[[site_name]]
  )
  
  ggsave(
    filename = output_file,
    plot = p,
    width = FIG_WIDTH,
    height = FIG_HEIGHT,
    units = "in",
    dpi = FIG_DPI,
    bg = "transparent"
  )
  
  cat(
    "\nSaved:",
    output_file,
    "\n"
  )
  
  cat(
    "Y-axis range:",
    y_lower,
    "to",
    y_upper,
    "kcal/mol\n"
  )
  
  return(p)
}


