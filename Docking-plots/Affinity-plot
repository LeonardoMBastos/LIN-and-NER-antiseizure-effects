# ============================================================
# 7. NORMALIZE TEXT
# ============================================================

normalize_text <- function(x) {
  x <- as.character(x)
  x <- trimws(x)
  x <- iconv(
    x,
    from = "",
    to = "ASCII//TRANSLIT"
  )
  toupper(x)
}


# ============================================================
# 8. STANDARDIZE COMPOUNDS
# ============================================================

map_compound <- function(x) {
  x2 <- normalize_text(x)
  
  dplyr::case_when(
    x2 %in% c(
      "DZP",
      "DIAZEPAM"
    ) ~ "DZP",
    
    x2 %in% c(
      "PHB",
      "PHENOBARBITAL",
      "FENOBARBITAL"
    ) ~ "PHB",
    
    x2 == "GABA" ~ "GABA",
    
    x2 %in% c(
      "LIN",
      "LINALOOL",
      "LINALOL"
    ) ~ "LIN",
    
    x2 %in% c(
      "NER",
      "NEROLIDOL",
      "TRANS-NEROLIDOL",
      "TRANS NEROLIDOL",
      "TRANS_NEROLIDOL",
      "TRANSNEROLIDOL"
    ) ~ "NER",
    
    TRUE ~ NA_character_
  )
}

# ============================================================
# 9. STANDARDIZE BINDING SITES
# ============================================================

map_site <- function(x) {
  x2 <- normalize_text(x)
  
  dplyr::case_when(
    x2 %in% c(
      "BENZODIAZEPINICOS",
      "BENZODIAZEPINAS",
      "BENZODIAZEPINES",
      "BENZODIAZEPINE",
      "BENZODIAZEPINE SITE",
      "BENZODIAZEPINE BINDING SITE",
      "BZD",
      "BZD SITE",
      "BZ",
      "BENZO"
    ) ~ "Benzodiazepine site",
    
    x2 %in% c(
      "BARBITURICOS",
      "BARBITURATES",
      "BARBITURATE",
      "BARBITURATE SITE",
      "BARBITURATE BINDING SITE",
      "BARBITURIC",
      "BARBITURIC SITE",
      "BB",
      "BARB"
    ) ~ "Barbiturate site",
    
    x2 %in% c(
      "GABA",
      "GABA ORTOSTATICO",
      "GABA ORTOSTERICO",
      "GABA ORTHOSTATIC",
      "GABA ORTHOSTERIC",
      "GABA ORTHOSTERIC SITE",
      "GABA ORTHOSTERIC BINDING SITE",
      "ORTHOSTERIC GABA",
      "GABA SITE",
      "GABA ORTHO"
    ) ~ "GABA orthosteric site",
    
    TRUE ~ NA_character_
  )
}


